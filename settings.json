{
  "env": {
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CLAUDE_CODE_SUBPROCESS_ENV_SCRUB": "0",
    "ENABLE_TOOL_SEARCH": "auto:1",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-4-8[1m]"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "disableClaudeAiConnectors": true,
  "worktree": {
    "baseRef": "fresh"
  },
  "enableWorkflows": false,
  "workflowKeywordTriggerEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "node \"$HOME/.claude/scripts/status-line.mts\""
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "node \"$HOME/.claude/scripts/subagent-status-line.mts\""
  },
  "enabledPlugins": {
    "chrome-devtools-mcp@claude-plugins-official": false,
    "context7@claude-plugins-official": true,
    "github@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": true,
    "rust-analyzer-lsp@claude-plugins-official": true
  },
  "outputStyle": "mp-terse",
  "effortLevel": "high",
  "autoCompactWindow": 233000,
  "autoUpdatesChannel": "stable",
  "minimumVersion": "2.1.220",
  "tui": "fullscreen",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "autoDreamEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "editorMode": "normal",
  "preferredNotifChannel": "auto",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": false,
  "voiceEnabled": true
}
