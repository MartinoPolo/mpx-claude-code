{
  "env": {
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CLAUDE_CODE_SUBPROCESS_ENV_SCRUB": "0",
    "ENABLE_TOOL_SEARCH": "auto:1",
    "ANTHROPIC_DEFAULT_OPUS_MODEL": "claude-opus-5[1m]"
  },
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "defaultMode": "auto"
  },
  "model": "opus[1m]",
  "disableClaudeAiConnectors": true,
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "node $HOME/.claude/hooks/format-lint-file.js",
            "timeout": 50
          }
        ]
      },
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node $HOME/.claude/hooks/post-bash-context.js",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node $HOME/.claude/hooks/enforce-pkg-mgr.js",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node $HOME/.claude/hooks/pre-commit-gate.js",
            "timeout": 130
          },
          {
            "type": "command",
            "command": "node $HOME/.claude/hooks/dangerous-command-guard.js",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "node $HOME/.claude/hooks/fallow-gate.js",
            "timeout": 30
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "node $HOME/.claude/hooks/machine-paths.js",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$HOME/.claude/hooks/herdr-agent-state.ps1\" session",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe -NoProfile -ExecutionPolicy Bypass -File \"$HOME/.claude/hooks/notify-flash-beep.ps1\"",
            "timeout": 10
          }
        ]
      }
    ]
  },
  "worktree": {
    "baseRef": "fresh"
  },
  "enableWorkflows": false,
  "workflowKeywordTriggerEnabled": false,
  "statusLine": {
    "type": "command",
    "command": "node \"$HOME/.claude/scripts/status-line.mts\""
  },
  "subagentStatusLine": {
    "type": "command",
    "command": "node \"$HOME/.claude/scripts/subagent-status-line.mts\""
  },
  "enabledPlugins": {
    "chrome-devtools-mcp@claude-plugins-official": false,
    "context7@claude-plugins-official": true,
    "github@claude-plugins-official": false,
    "typescript-lsp@claude-plugins-official": true
  },
  "effortLevel": "low",
  "autoCompactWindow": 213000,
  "autoUpdatesChannel": "stable",
  "minimumVersion": "2.1.220",
  "voice": {
    "enabled": true,
    "mode": "hold"
  },
  "autoDreamEnabled": true,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "editorMode": "normal",
  "preferredNotifChannel": "auto",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": false,
  "voiceEnabled": true
}
